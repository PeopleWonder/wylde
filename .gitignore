# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# uv-managed virtualenv (uv.lock is committed, .venv is not)
.venv/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local agent scratchpad (slice reports + intermediate artifacts); keep the README
outputs/*
!outputs/README.md

# gpui GUI build output (the Tauri+Svelte tree was deleted at the
# slice-11 cutover; the standalone Core/GUI/ Cargo workspace builds here)
Core/GUI/target/

# Cargo build artifacts (backend Rust workspace at rust/)
rust/target/

# Installer build output (tools/installer/build-installer.ps1 stages here)
release-artifacts/

# Any other Cargo target dirs (catch-all)
target/

# Local data (runtime state — never committed)
data/
logs/
*.log
.wylde/

# Runtime service registry (regenerated by discovery on boot). Seed lives at services.yaml.seed.
Core/Network/services.yaml

# Per-test scratch dir (conftest redirects the IPC audit log here). Runtime
# artifact — was tracked by mistake; dirties the tree on every test run.
Core/shared/tests/_tmp/

# Editors / IDEs
.vscode/
.idea/

# Environment variables / secrets — never committed
# (.env.example / .env.sample stay tracked as templates)
.env
.env.local
.env.*.local
*.local.env
secrets.yaml
secrets.toml
secrets.json
*.secret
*.secret.*

Core/Memgraph/vendor/

# Local-only planning docs (kept on disk for reference, not published)
docs/plans/

# Private planning/design docs (kept locally, not published)
docs/privacy-plan.md
docs/wylde-rust-migration-master-plan.md
docs/wylde-android-app-plan.md
docs/wylde-gpui-rewrite-plan.md
docs/wylde-gui-panel-architecture-plan.md
docs/wylde-ollama-design.md
docs/wylde-voice-npu-spike-findings.md
docs/wylde-voice-cutover-state.md
docs/wylde-voice-inference-default.md
docs/audit/lifecycle-slice-report.md
docs/refactor-archive/PHASE6_TOOLING_PLAN.md
docs/refactor-archive/BACKEND_MIGRATION_MAP.md
docs/refactor-archive/MEMORY_MIGRATION_MAP.md
Core/GUI/docs/inference-bar-migration-plan.md
