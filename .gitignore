# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Local Python virtualenv for the dev-time wylde_check linter (.venv is not tracked).
# NOTE: uv.lock was deleted in the full-Rust cutover (commit 2f5aa82) and is no
# longer committed — there is no runtime Python dependency lockfile anymore.
.venv/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Engineering record (slice reports). Canonical tracked home is the private
# PeopleWonder/wylde-planning repo, junctioned in at Core/outputs (see
# docs/branch-and-release-policy.md "Where things live"). Ignored wholesale here
# so the junction is invisible to this public repo.
outputs/

# gpui GUI build output (the Tauri+Svelte tree was deleted at the
# slice-11 cutover; the standalone Core/GUI/ Cargo workspace builds here)
Core/GUI/target/

# Cargo build artifacts (backend Rust workspace at rust/)
rust/target/

# Installer build output (tools/installer/build-installer.ps1 stages here)
release-artifacts/

# Any other Cargo target dirs (catch-all)
target/

# Out-of-tree runtime buckets (container-of-repos). Core's tracked tree
# stays just-Core: the three buckets ship EMPTY and are populated
# out-of-band, each item keeping its own independent .git. The lifecycle
# registry + extension bridge discover whatever is dropped in at runtime,
# and the boot/shutdown paths cleanly no-op when a bucket is absent or
# empty ("core works without"). See outputs/wylde-out-of-tree-runtime-plan.md.
#   * Services/      — sibling full-tier service repos (lifecycle-supervised)
#   * Extensions/    — leave-the-ecosystem extensions (extension-bridge)
#   * Core/Plugins/  — compiled-in plugin crates (opt-in; wired into the
#                      rust/ workspace by hand when present — see
#                      rust/crates/wylde-harness/src/plugins/mod.rs)
/Services/
/Extensions/
/Core/Plugins/

# Local data (runtime state — never committed)
data/
logs/
*.log
.wylde/

# Runtime service registry (regenerated by discovery on boot). Seed lives at services.yaml.seed.
Core/Network/services.yaml

# Per-test scratch dir (conftest redirects the IPC audit log here). Runtime
# artifact — was tracked by mistake; dirties the tree on every test run.
Core/shared/tests/_tmp/

# Editors / IDEs
.vscode/
.idea/

# Environment variables / secrets — never committed
# (.env.example / .env.sample stay tracked as templates)
.env
.env.local
.env.*.local
*.local.env
secrets.yaml
secrets.toml
secrets.json
*.secret
*.secret.*

Core/Memgraph/vendor/

# Local-only planning docs (kept on disk for reference, not published)
docs/plans/

