{
  "id": "caption_video",
  "name": "caption_video",
  "description": "Sample frames from a video and produce a single aggregated caption (or per-frame list). Uses the Caption module's Florence-2 captioner by default.",
  "version": "1.0",
  "service": "Caption",
  "group": "caption",
  "entrypoint": "run_caption_video",
  "tags": ["vision", "caption", "video", "florence-2"],
  "parameters": [
    {"name": "video_path",  "type": "string",  "required": true,  "description": "Absolute path to a video file (.mp4/.mov/.mkv/.webm/.avi)"},
    {"name": "detail",      "type": "string",  "required": false, "default": "detailed", "description": "Caption length: brief | normal | detailed"},
    {"name": "trigger",     "type": "string",  "required": false, "description": "Optional trigger word prefix"},
    {"name": "backend",     "type": "string",  "required": false, "description": "Force a backend: florence | qwen | joycaption"},
    {"name": "mode",        "type": "string",  "required": false, "description": "Frame sampling mode: count | fps | interval_s"},
    {"name": "frame_count", "type": "number",  "required": false, "description": "Number of frames to sample (mode=count)"},
    {"name": "target_fps",  "type": "number",  "required": false, "description": "Target sample fps (mode=fps)"},
    {"name": "interval_s",  "type": "number",  "required": false, "description": "Seconds between sampled frames (mode=interval_s)"},
    {"name": "aggregate",   "type": "string",  "required": false, "description": "all | first | middle | summary (default: summary)"},
    {"name": "write_txt",   "type": "boolean", "required": false, "default": false, "description": "Write caption to <video>.txt"},
    {"name": "overwrite",   "type": "boolean", "required": false, "default": false, "description": "Overwrite existing sidecar .txt"},
    {"name": "write_frames","type": "boolean", "required": false, "default": false, "description": "Also dump sampled frames + per-frame .txt"}
  ]
}
