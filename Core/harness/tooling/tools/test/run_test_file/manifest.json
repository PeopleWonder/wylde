{
  "id": "run_test_file",
  "name": "run_test_file",
  "description": "Run a single test file. Auto-detects pytest / vitest / jest like `run_tests`. Pass `framework` to override.",
  "version": "2.0",
  "service": "harness",
  "group": "test",
  "entrypoint": "run_run_test_file",
  "tags": ["test", "pytest", "vitest", "jest"],
  "parameters": [
    {"name": "file", "type": "string", "required": true, "description": "Path to the test file"},
    {"name": "path", "type": "string", "required": false, "default": ".", "description": "Project root"},
    {"name": "framework", "type": "string", "required": false, "description": "pytest | vitest | jest (auto-detected if omitted)"},
    {"name": "timeout", "type": "number", "required": false, "default": 300, "description": "Max seconds before the run is killed"}
  ]
}
