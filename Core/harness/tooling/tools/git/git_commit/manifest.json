{
  "id": "git_commit",
  "name": "git_commit",
  "description": "Create a commit with the given message. Pass `allow_empty=true` to permit a commit with no staged changes.",
  "version": "2.0",
  "service": "harness",
  "group": "git",
  "entrypoint": "run_git_commit",
  "tags": ["git", "vcs", "commit"],
  "parameters": [
    {"name": "path", "type": "string", "required": false, "default": ".", "description": "Working tree path"},
    {"name": "message", "type": "string", "required": true, "description": "Commit message"},
    {"name": "allow_empty", "type": "boolean", "required": false, "default": false, "description": "Permit empty commit"}
  ]
}
