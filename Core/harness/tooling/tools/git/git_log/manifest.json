{
  "id": "git_log",
  "name": "git_log",
  "description": "Recent commit history. Returns sha, short sha, author, email, unix timestamp, and subject for each commit.",
  "version": "2.0",
  "service": "harness",
  "group": "git",
  "entrypoint": "run_git_log",
  "tags": ["git", "vcs", "log", "history"],
  "parameters": [
    {"name": "path", "type": "string", "required": false, "default": ".", "description": "Working tree path"},
    {"name": "limit", "type": "number", "required": false, "default": 20, "description": "Number of commits to return"}
  ]
}
