{
  "id": "git_branch",
  "name": "git_branch",
  "description": "List, create, switch, or delete branches. Action is one of `list` | `create` | `switch` | `delete` (default: `list`).",
  "version": "2.0",
  "service": "harness",
  "group": "git",
  "entrypoint": "run_git_branch",
  "tags": ["git", "vcs", "branch"],
  "parameters": [
    {"name": "path", "type": "string", "required": false, "default": ".", "description": "Working tree path"},
    {"name": "action", "type": "string", "required": false, "default": "list", "description": "list | create | switch | delete"},
    {"name": "name", "type": "string", "required": false, "description": "Branch name (required unless action=list)"}
  ]
}
