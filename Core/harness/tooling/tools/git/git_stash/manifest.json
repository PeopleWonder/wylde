{
  "id": "git_stash",
  "name": "git_stash",
  "description": "Manage stash entries. Action is one of `push` | `pop` | `list` | `drop` (default: `push`). Optional `message` is used only on push.",
  "version": "2.0",
  "service": "harness",
  "group": "git",
  "entrypoint": "run_git_stash",
  "tags": ["git", "vcs", "stash"],
  "parameters": [
    {"name": "path", "type": "string", "required": false, "default": ".", "description": "Working tree path"},
    {"name": "action", "type": "string", "required": false, "default": "push", "description": "push | pop | list | drop"},
    {"name": "message", "type": "string", "required": false, "description": "Stash message (push only)"}
  ]
}
