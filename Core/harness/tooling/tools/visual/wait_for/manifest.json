{
  "id": "wait_for",
  "name": "wait_for",
  "description": "Wait for a DOM element to reach a state (visible, hidden, attached, detached) via Playwright.",
  "version": "2.0",
  "service": "harness",
  "group": "visual",
  "entrypoint": "run_wait_for",
  "tags": ["visual", "browser", "wait", "playwright"],
  "parameters": [
    {"name": "selector", "type": "string", "required": true, "description": "CSS selector to wait for"},
    {"name": "state", "type": "string", "required": false, "default": "visible", "description": "'visible', 'hidden', 'attached', or 'detached'"},
    {"name": "timeout", "type": "number", "required": false, "default": 10000, "description": "Max wait time in milliseconds"}
  ]
}
