{
  "id": "mouse_move",
  "name": "mouse_move",
  "description": "Move the mouse cursor to screen coordinates without clicking. Useful for triggering hover states.",
  "version": "2.0",
  "service": "harness",
  "group": "visual",
  "entrypoint": "run_mouse_move",
  "tags": ["visual", "mouse", "desktop", "pyautogui"],
  "parameters": [
    {"name": "x", "type": "number", "required": true, "description": "X coordinate"},
    {"name": "y", "type": "number", "required": true, "description": "Y coordinate"},
    {"name": "duration", "type": "number", "required": false, "default": 0.2, "description": "Seconds for the movement (0 = instant)"}
  ]
}
