{
  "id": "click",
  "name": "click",
  "description": "Click at desktop screen coordinates with PyAutoGUI.",
  "version": "2.0",
  "service": "harness",
  "group": "visual",
  "entrypoint": "run_click",
  "tags": ["visual", "click", "desktop", "pyautogui"],
  "parameters": [
    {"name": "x", "type": "number", "required": true, "description": "X coordinate"},
    {"name": "y", "type": "number", "required": true, "description": "Y coordinate"},
    {"name": "button", "type": "string", "required": false, "default": "left", "description": "'left', 'right', or 'middle'"},
    {"name": "clicks", "type": "number", "required": false, "default": 1, "description": "Number of clicks"}
  ]
}
