{
  "id": "browser_fill",
  "name": "browser_fill",
  "description": "Fill a form input field in the browser by CSS selector via Playwright.",
  "version": "2.0",
  "service": "harness",
  "group": "visual",
  "entrypoint": "run_browser_fill",
  "tags": ["visual", "browser", "form", "playwright"],
  "parameters": [
    {"name": "selector", "type": "string", "required": true, "description": "CSS selector of the input element"},
    {"name": "value", "type": "string", "required": true, "description": "Text to fill"},
    {"name": "timeout", "type": "number", "required": false, "default": 10000, "description": "Fill timeout in milliseconds"}
  ]
}
