{
  "id": "study_summarize",
  "name": "study_summarize",
  "description": "Summarize the supplied text via the configured LLM. Returns a short structured summary + key points.",
  "version": "1.0",
  "service": "extension",
  "group": "study",
  "extension": "Wylde_Study",
  "entrypoint": "summarize",
  "tags": ["study", "summarize", "llm"],
  "parameters": [
    {"name": "text", "type": "string", "required": true, "description": "Text to summarize"},
    {"name": "model", "type": "string", "required": false, "description": "Model name (defaults to harness default)"},
    {"name": "max_words", "type": "number", "required": false, "default": 150, "description": "Target summary length in words"}
  ]
}
