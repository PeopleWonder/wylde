{
  "manifest_version": 3,
  "name": "Wylde Study",
  "version": "0.2.0",
  "description": "Index pages, ask questions, summarise, explain, and generate flashcards using your local Wylde LLMs.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Wylde Study",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "Open the Wylde Study panel"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "config.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
