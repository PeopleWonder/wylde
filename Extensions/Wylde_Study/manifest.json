{
  "name": "Wylde_Study",
  "description": "Chrome browser-side study assistant. Indexes pages into the Wylde memory graph, answers questions over the indexed corpus via RAG, and generates summaries / explanations / flashcards via the configured LLM. Receives requests over HTTP from the browser extension; routes them into harness/memory and harness/backend.",
  "version": "0.2.0",
  "enabled": false,
  "transport": "http",
  "handler": "handler",
  "browser_extension_path": "browser_extension",
  "capabilities": ["ingress.browser", "egress.browser"],
  "tools": [
    {
      "tool_id": "study_index_page",
      "group": "study",
      "endpoint": "index_page",
      "description": "Index a web page (title + URL + extracted text) into the Wylde memory graph as an episodic memory.",
      "parameters": [
        {"name": "url", "type": "string", "required": true, "description": "Page URL"},
        {"name": "title", "type": "string", "required": false, "description": "Page title"},
        {"name": "text", "type": "string", "required": true, "description": "Extracted text content"},
        {"name": "session_id", "type": "string", "required": false, "description": "Session id grouping pages indexed together"}
      ],
      "tags": ["study", "memory", "ingest"]
    },
    {
      "tool_id": "study_query",
      "group": "study",
      "endpoint": "query",
      "description": "Answer a question against the indexed corpus. Wraps rag.search and returns the top-k matching chunks for the LLM (or extension UI) to ground on.",
      "parameters": [
        {"name": "q", "type": "string", "required": true, "description": "Question"},
        {"name": "limit", "type": "number", "required": false, "default": 8, "description": "Max chunks (1..50)"}
      ],
      "tags": ["study", "rag", "search"]
    },
    {
      "tool_id": "study_summarize",
      "group": "study",
      "endpoint": "summarize",
      "description": "Summarize the supplied text via the configured LLM. Returns a short structured summary + key points.",
      "parameters": [
        {"name": "text", "type": "string", "required": true, "description": "Text to summarize"},
        {"name": "model", "type": "string", "required": false, "description": "Model name (defaults to harness default)"},
        {"name": "max_words", "type": "number", "required": false, "default": 150, "description": "Target summary length"}
      ],
      "tags": ["study", "summarize", "llm"]
    },
    {
      "tool_id": "study_explain",
      "group": "study",
      "endpoint": "explain",
      "description": "Explain a concept or selection of text in plain language via the LLM.",
      "parameters": [
        {"name": "text", "type": "string", "required": true, "description": "Concept or excerpt to explain"},
        {"name": "audience", "type": "string", "required": false, "default": "general", "description": "Audience hint, e.g. 'high school', 'expert'"},
        {"name": "model", "type": "string", "required": false, "description": "Model name (defaults to harness default)"}
      ],
      "tags": ["study", "explain", "llm"]
    },
    {
      "tool_id": "study_flashcards",
      "group": "study",
      "endpoint": "flashcards",
      "description": "Generate Q/A flashcards from the supplied text via the LLM. Returns a list of {front, back} objects.",
      "parameters": [
        {"name": "text", "type": "string", "required": true, "description": "Source material"},
        {"name": "count", "type": "number", "required": false, "default": 8, "description": "How many cards to generate (1..50)"},
        {"name": "model", "type": "string", "required": false, "description": "Model name (defaults to harness default)"}
      ],
      "tags": ["study", "flashcards", "llm"]
    }
  ]
}
