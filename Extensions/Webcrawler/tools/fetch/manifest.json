{
  "id": "fetch",
  "name": "fetch",
  "description": "Fetch raw contents from a URL. Returns the body as text or parsed JSON depending on 'format'. External egress routes through Wylde.Gateway.client.",
  "version": "1.0",
  "service": "extension",
  "group": "web",
  "extension": "Webcrawler",
  "entrypoint": "run_fetch",
  "tags": ["web", "fetch", "http"],
  "parameters": [
    {"name": "url", "type": "string", "required": true, "description": "URL to fetch"},
    {"name": "format", "type": "string", "required": false, "default": "text", "description": "Response format: 'text' (default) or 'json'"},
    {"name": "timeout", "type": "number", "required": false, "default": 10, "description": "Request timeout in seconds"}
  ]
}
